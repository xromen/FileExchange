<Window x:Class="FileExchange.Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Файловый обмен — управление" Width="920" Height="890" MinWidth="850" MinHeight="870"
        WindowStartupLocation="CenterScreen" Background="#F6F7FB" FontFamily="Segoe UI" FontSize="14"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </Window.Resources>
    <Grid x:Name="MainPanel" Margin="20" Background="#F6F7FB">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Управление файловым обменом" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock x:Name="UserText" Foreground="#586477" Margin="0,5,0,0"/>
        </StackPanel>
        <GroupBox Grid.Row="1" Header="Установка и обновление">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="PackageBox" IsReadOnly="True" AutomationProperties.Name="Папка распакованной сборки" Margin="0,0,10,10"/>
                <Button Grid.Column="1" Content="Выбрать сборку…" Click="BrowsePackage_Click" Margin="0,0,0,10"/>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                    <Button Content="Установить / обновить" Click="Install_Click" Background="#2463EB" Foreground="White"/>
                    <Button Content="Удалить меню" Click="Uninstall_Click"/>
                    <Button Content="Обновить список" Click="Reload_Click"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Margin="0,12,10,0">
                    <TextBlock x:Name="CurrentVersionText" Foreground="#586477"/>
                    <TextBlock x:Name="ReleaseVersionText" Text="Версия в GitHub Releases: не проверена" Foreground="#586477" Margin="0,3,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Row="2" Grid.Column="1" x:Name="CheckUpdateButton" Content="Проверить обновление" Click="CheckUpdate_Click" Margin="0,12,0,0" VerticalAlignment="Center"/>
            </Grid>
        </GroupBox>
        <GroupBox Grid.Row="2" Header="Настройки меню и копирования">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="ParentNameBox" Text="Файловый обмен" AutomationProperties.Name="Название родительского меню" Margin="0,0,10,0"/>
                <Button Grid.Column="1" Content="Применить изменения" Click="SaveParent_Click" Margin="0"/>
                <CheckBox Grid.Row="1" Grid.ColumnSpan="2" x:Name="OpenFolderAfterCopyBox" Content="Открывать папку после копирования файлов" IsChecked="False" Margin="0,12,0,8"/>
                <CheckBox Grid.Row="2" Grid.ColumnSpan="2" x:Name="CopyFolderPathAfterCopyBox" Content="Копировать путь до папки после копирования" IsChecked="False"/>
            </Grid>
        </GroupBox>
        <GroupBox Grid.Row="3" Header="Подпункты меню">
            <DataGrid x:Name="DestinationList" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="DestinationList_SelectionChanged"
                      GridLinesVisibility="Horizontal" RowHeight="32" HeadersVisibility="Column" MinHeight="110">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="230"/>
                    <DataGridTextColumn Header="Папка назначения" Binding="{Binding DestinationPath}" Width="*" MinWidth="450"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
        <GroupBox Grid.Row="4" Header="Добавить или изменить подпункт">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Label Content="Название:" Target="{Binding ElementName=ItemNameBox}"/>
                <TextBox Grid.Column="1" Grid.ColumnSpan="2" x:Name="ItemNameBox" Margin="0,0,0,8"/>
                <Label Grid.Row="1" Content="Папка назначения:" Target="{Binding ElementName=DestinationBox}"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="DestinationBox" Margin="0,0,10,10"/>
                <Button Grid.Row="1" Grid.Column="2" Content="Обзор…" Click="BrowseDestination_Click" Margin="0,0,0,10"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                    <Button Content="Добавить" Click="Add_Click"/>
                    <Button x:Name="SaveButton" Content="Сохранить изменения" Click="Edit_Click" IsEnabled="False"/>
                    <Button x:Name="DeleteButton" Content="Удалить пункт" Click="Delete_Click" IsEnabled="False"/>
                    <Button Content="Очистить поля" Click="Clear_Click" Margin="0"/>
                </StackPanel>
            </Grid>
        </GroupBox>
        <StackPanel Grid.Row="5">
            <TextBlock x:Name="StatusText" Text="Готово к работе." TextWrapping="Wrap" Foreground="#2463EB"/>
            <TextBlock Text="Изменения применяются к меню текущего пользователя. Пустой список скрывает меню." Foreground="#586477" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
    </Grid>
</Window>
